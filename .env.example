# Server settings for the Docker image (copy to .env next to docker-compose.yml).
# Never commit .env.

# Shared accounts service (see the accounts project). Same token as its SERVICE_TOKEN.
ACCOUNTS_URL=http://accounts:4600
ACCOUNTS_SERVICE_TOKEN=
# Set to false only for local development over plain http.
COOKIE_SECURE=true

# TMDB and OMDb, used by the server only (app/api/tmdb, app/api/omdb): the
# browser never sees them. TMDB: the API Read Access Token (starts with eyJ).
TMDB_TOKEN=
OMDB_KEY=
